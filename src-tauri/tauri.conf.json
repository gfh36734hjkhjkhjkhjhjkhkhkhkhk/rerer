{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.4.0",
  "identifier": "io.github.lucudar.prism",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prism",
        "width": 780,
        "height": 640,
        "minWidth": 640,
        "minHeight": 540,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "lucudar",
    "shortDescription": "Обход блокировок и прокси Telegram",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  }
}
